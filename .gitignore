### Unoarm (custom_envs) ###
# Datasets, virtualenvs, and build artifacts are NOT tracked. Robot assets
# under custom_envs/*/gym_unoarm/ (meshes/*.stl, *.xml, *.urdf) ARE tracked —
# they are required to run the simulation. Do not add *.stl / *.xml / *.urdf
# as global ignore rules or you will silently exclude the model assets.
custom_envs/*/data/
custom_envs/*/.venv/
custom_envs/*/*.egg-info/
custom_envs/*/build/
# Per-package uv.lock files are regenerated; only the root uv.lock is tracked.
custom_envs/*/uv.lock
uv.lock.*.bak

# MuJoCo compiled model cache (regenerated from XML at runtime)
*.mjb

# Pretrained model weights (managed via HF Hub / external storage, not git)
pretrained/
pretrained_model/
pretrained_model.zip

# Local bootstrap tools and runtime caches
.tools/
.runtime-cache/

# Platform metadata and local simulator logs
*:Zone.Identifier
MUJOCO_LOG.TXT

# ZCode session plans (tool-internal, not project artifacts)
.zcode/
